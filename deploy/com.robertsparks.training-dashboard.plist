<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.robertsparks.training-dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/robertsparks/Projects/race-training-dashboard/scripts/serve.sh</string>
  </array>

  <!-- launchd starts jobs with a bare PATH; uv lives in the Python framework's bin folder -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.12/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <!-- restart it if it crashes -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/robertsparks/Library/Logs/training-dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/robertsparks/Library/Logs/training-dashboard.log</string>
</dict>
</plist>
