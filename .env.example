# Copy to .env (gitignored) and run:  uv run --env-file .env uvicorn app.main:app --port 8000
# Login password for the whole app. Leave empty ONLY when running on localhost.
DASHBOARD_PASSWORD=
# Optional: signing key for login cookies (default: derived from the password).
# SESSION_SECRET=
# Optional: set to 1 when a proxy terminates HTTPS in front of the app.
# COOKIE_SECURE=1
# Optional: minutes between background Garmin syncs (default 30, 0 = off).
# SYNC_INTERVAL_MIN=30
